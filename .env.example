# Dita — variáveis de ambiente (opcionais)
#
# A configuração normal fica em ~/.config/dita/azure.env e é criada pelo
# instalador. Este arquivo serve para quem roda manualmente.

# Provedor: local (Whisper na sua máquina) ou azure
DITA_PROVIDER=local

# Caminhos do whisper.cpp
DITA_WHISPER_BIN=
DITA_WHISPER_MODEL=

# Idioma (pt, en, es… ou auto)
DITA_LANGUAGE=pt

# Threads de CPU (vazio = metade dos núcleos)
DITA_WHISPER_THREADS=

# Porta da interface
PORT=3927

# --- Azure (opcional) ---
# AZURE_OPENAI_REALTIME_URL=
